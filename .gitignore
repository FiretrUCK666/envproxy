# OS junk
Thumbs.db
.DS_Store

# editors / IDE
.vscode/
.idea/
*.swp
*~

# EnvProxy runtime state (auto-created next to each platform core, machine-local).
# Never commit: a clone recreates them on first run (mkdir -p).
win/monitor/monitor.log
win/monitor/monitor.pid
win/monitor/stop.flag
# "停止"是一次跨重启仍然有效的意图，所以它落在磁盘上而不是内存里。
win/monitor/stopped.intent
mac/monitor/monitor.log
mac/monitor/monitor.pid
mac/monitor/stop.flag
# 操作锁（mac 侧用文件锁；正常退出会自己删，被 kill -9 或断电时会留下）
mac/monitor/.op.lock
mac/monitor/.op.lock.tmp.*
# 监控单实例锁（目录形式）：被强杀时同样会留下空目录
mac/monitor/.lock/
mac/monitor/.lock

# temp / local bundles (README ships the folder via USB/drive/zip)
*.tmp
*.bak
*.zip
*.tar.gz
dist/

# 临时工作目录（子代理走查、本地草稿），不入库
_*/

# 仓库根只放 README / LICENSE / VERSION 和目录，不放脚本（入口都在 win/ 与 mac/ 里）。
# 根下冒出 .sh/.ps1 几乎一定是误操作——例如把平台目录里的文件复制了一份出来调试。
# 这种游离副本会随 git add -A 一起入库，然后静默进两端安装包的根目录：
# 每个用户的安装根多几个垃圾文件，mac 侧还会给定位器多一个同名候选。
/*.sh
/*.ps1
/*.cmd
/*.command
