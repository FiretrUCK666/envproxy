# EnvProxy runtime state (auto-created next to each platform core, machine-local).
# Never commit: a clone recreates them on first run (mkdir -p).
win/monitor/monitor.log
win/monitor/monitor.pid
win/monitor/stop.flag
mac/monitor/monitor.log
mac/monitor/monitor.pid
mac/monitor/stop.flag
# 操作锁（mac 侧用文件锁；正常退出会自己删，被 kill -9 或断电时会留下）
mac/monitor/.op.lock
mac/monitor/.op.lock.tmp.*

# temp / local bundles (README ships the folder via USB/drive/zip)
*.tmp
*.bak
*.zip
*.tar.gz
dist/

