# OS junk
Thumbs.db
.DS_Store

# editors / IDE
.vscode/
.idea/
*.swp
*~

# EnvProxy runtime state (auto-created next to each platform core, machine-local).
# 整个运行时目录一律不入库。逐个列文件名的话，每加一个运行时文件就要记得补一行，
# 漏一次它就会随 git add -A 入库、跟着进安装包——而 monitor/ 是「每台机器自己生成」的东西
# （日志、pid、各类临时标记与缓存）。目录本身由脚本 mkdir -p 自建，不需要 git 记住它。
win/monitor/
mac/monitor/

# temp / local bundles (README ships the folder via USB/drive/zip)
*.tmp
*.bak
*.zip
*.tar.gz
dist/

# 临时工作目录（子代理走查、本地草稿），不入库
_*/

# 仓库根只放 README / LICENSE / VERSION 和目录，不放脚本（入口都在 win/ 与 mac/ 里）。
# 根下冒出 .sh/.ps1 几乎一定是误操作——例如把平台目录里的文件复制了一份出来调试。
# 这种游离副本会随 git add -A 一起入库，然后静默进两端安装包的根目录：
# 每个用户的安装根多几个垃圾文件，mac 侧还会给定位器多一个同名候选。
/*.sh
/*.ps1
/*.cmd
/*.command
